<wxs src="../../utils/filters.wxs" module="f" />
<view class="page-profile">
  <!-- Avatar and name -->
  <view class="profile-header">
    <view class="avatar">
      <text class="avatar-emoji">👤</text>
    </view>
    <text class="name">{{userInfo.nickName || '微信用户'}}</text>
  </view>

  <!-- Stats row -->
  <view class="stats-row">
    <view class="stats-item">
      <text class="stats-value">{{f.formatPoints(userInfo.totalPoints)}}</text>
      <text class="stats-label">积分</text>
    </view>
    <view class="stats-item">
      <text class="stats-value">{{productCount}}</text>
      <text class="stats-label">兑换</text>
    </view>
  </view>

  <!-- Menu list -->
  <view class="menu-list">
    <view class="menu-item" bindtap="goPage" data-url="/pages/my-products/index">
      <text class="icon">🎁</text>
      <text class="title">我的兑换</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goPage" data-url="/pages/points/index">
      <text class="icon">💰</text>
      <text class="title">积分明细</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goPage" data-url="/pages/lottery/index">
      <text class="icon">🎰</text>
      <text class="title">幸运转盘</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goPage" data-url="/pages/referral/index">
      <text class="icon">👥</text>
      <text class="title">分销统计</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" wx:if="{{isMerchant}}" bindtap="goPage" data-url="/pages/merchant-home/index">
      <text class="icon">🏪</text>
      <text class="title">商户管理</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- Logout button -->
  <view class="logout-btn" bindtap="logout">退出登录</view>
</view>
