/* ========================================
   My Products - Dreamy Candy Theme
   ======================================== */

/* ========== Page Container ========== */
.page-my-products {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding-bottom: 120rpx;
}

/* ========== Tab Switch ========== */
.tab-switch {
  display: flex;
  padding: 0 32rpx;
  margin-bottom: 32rpx;
  background: #FFFFFF;
  border-bottom: 2rpx solid rgba(255, 126, 179, 0.1);
  position: relative;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: var(--color-text-tertiary);
  border-bottom: 4rpx solid transparent;
  position: relative;
  transition: all 0.3s ease;
}

.tab-item.active {
  color: var(--color-primary);
  font-weight: var(--weight-medium);
  border-bottom-color: transparent;
}

/* Gradient underline for active tab */
.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: -2rpx;
  left: 25%;
  right: 25%;
  height: 6rpx;
  background: var(--gradient-primary);
  border-radius: 3rpx;
}

/* ========== Product List ========== */
.product-list {
  padding: 0 32rpx;
}

.product-item {
  background: #FFFFFF;
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
  border: 1rpx solid rgba(255, 126, 179, 0.06);
  transition: transform 0.2s ease;
}

.product-item:active {
  transform: scale(0.98);
}

.product-item .header {
  display: flex;
  align-items: center;
}

/* Product thumbnail with soft rounded corners */
.product-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-md);
  flex-shrink: 0;
  margin-right: 24rpx;
  background: var(--color-primary-light);
}

/* Product text details */
.product-detail {
  flex: 1;
  min-width: 0;
}

.product-detail .name {
  font-size: 32rpx;
  font-weight: var(--weight-bold);
  color: var(--color-text-primary);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-detail .expiry {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  margin-top: 8rpx;
  display: block;
}

/* ========== Verify Code Section ========== */
.verify-section {
  margin-top: 32rpx;
  padding-top: 32rpx;
  border-top: 2rpx dashed var(--color-border);
  text-align: center;
}

.verify-label {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  margin-bottom: 16rpx;
  display: block;
}

/* Large monospace verify code with dreamy pink glow */
.verify-code {
  font-family: 'Courier New', 'SFMono-Regular', Consolas, monospace;
  font-size: 72rpx;
  font-weight: var(--weight-bold);
  color: var(--color-primary);
  letter-spacing: 16rpx;
  text-align: center;
  display: block;
  margin: 16rpx 0;
  text-shadow: 0 2rpx 16rpx rgba(255, 126, 179, 0.15);
}

.verify-code.masked {
  letter-spacing: 8rpx;
}

/* QR Code display area */
.qrcode-wrap {
  display: flex;
  justify-content: center;
  margin-top: 24rpx;
}

.qrcode-canvas {
  width: 400rpx;
  height: 400rpx;
  background: #FFFFFF;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border-light);
  box-shadow: 0 4rpx 16rpx rgba(255, 126, 179, 0.06);
}

/* Show/hide toggle - soft pill button */
.btn-show {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  padding: 20rpx 32rpx;
  background: var(--color-primary-light);
  color: var(--color-primary);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  font-weight: var(--weight-medium);
  transition: all 0.2s ease;
}

.btn-show:active {
  background: rgba(255, 126, 179, 0.15);
  transform: scale(0.98);
}

/* ========== Used / Expired Status ========== */
.used-info {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx dashed var(--color-border);
  text-align: center;
}

.used-text {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  display: block;
}

.expired-info {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx dashed var(--color-border);
  text-align: center;
}

.expired-text {
  font-size: 26rpx;
  color: var(--color-danger);
  display: block;
}
