/* ============================================
   Merchant Products - Dreamy Candy Style
   梦幻糖果风 · 商品管理
   ============================================ */

/* --- Page Container --- */
.page-merchant-products {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding-bottom: 120rpx;
}

/* --- Add Product Bar --- */
.add-bar {
  margin: 32rpx;
  padding: 28rpx;
  background: var(--gradient-primary);
  color: #FFFFFF;
  border-radius: 28rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 28rpx rgba(255, 126, 179, 0.25),
              0 0 40rpx rgba(255, 126, 179, 0.1);
  letter-spacing: 2rpx;
  position: relative;
  overflow: hidden;
}

.add-bar::after {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(
    45deg,
    transparent 30%,
    rgba(255, 255, 255, 0.08) 50%,
    transparent 70%
  );
  pointer-events: none;
}

.add-bar:active {
  opacity: 0.9;
  transform: scale(0.98);
}

/* --- Product List --- */
.product-list {
  padding: 0 32rpx;
}

/* --- Product Item Card --- */
.product-item {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(255, 126, 179, 0.08),
              0 2rpx 8rpx rgba(179, 136, 255, 0.04);
  border: 1rpx solid rgba(255, 126, 179, 0.06);
  transition: transform 0.2s ease;
}

.product-item:active {
  background: var(--color-bg-hover);
}

/* --- Product Thumbnail --- */
.product-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  margin-right: 24rpx;
  background: var(--color-border-light);
}

/* --- Product Info --- */
.product-info {
  flex: 1;
  min-width: 0;
}

.product-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-meta {
  display: flex;
  gap: 24rpx;
  margin-top: 8rpx;
}

.meta-text {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

/* --- Status Tags --- */
.status-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  margin-top: 12rpx;
  font-weight: 500;
}

.status-tag.active {
  background: #EEFBF5;
  color: #69DBAF;
}

.status-tag.inactive {
  background: #FFF2F2;
  color: #FF7979;
}

/* --- Product Actions --- */
.product-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.btn-action {
  padding: 12rpx 24rpx;
  background: var(--color-primary-light);
  color: var(--color-primary);
  border-radius: 16rpx;
  font-size: 24rpx;
  text-align: center;
  font-weight: 500;
  transition: opacity 0.2s ease;
}

.btn-action.btn-danger {
  background: #FFF2F2;
  color: var(--color-danger);
}

.btn-action:active {
  opacity: 0.8;
}
