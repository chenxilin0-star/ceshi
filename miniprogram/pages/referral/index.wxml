<wxs src="../../utils/filters.wxs" module="f" />
<view class="page-referral">
  <!-- Hero header -->
  <view class="referral-hero">
    <view class="hero-bg hero-bg-one"></view>
    <view class="hero-bg hero-bg-two"></view>
    <view class="hero-inner">
      <text class="hero-label">分销渠道</text>
      <text class="hero-title">邀请好友，一起赚积分</text>
    </view>
  </view>

  <!-- Stats cards -->
  <view class="stats-grid">
    <view class="stat-card">
      <view class="stat-icon-wrap">
        <text class="stat-icon">👥</text>
      </view>
      <text class="value">{{referralCount}}</text>
      <text class="label">推荐人数</text>
    </view>
    <view class="stat-card stat-card-accent">
      <view class="stat-icon-wrap">
        <text class="stat-icon">💎</text>
      </view>
      <text class="value">{{f.formatPoints(totalReferralPoints)}}</text>
      <text class="label">分销积分</text>
    </view>
  </view>

  <!-- Rules card -->
  <view class="rules-card card">
    <view class="rules-header">
      <text class="rules-icon">📋</text>
      <text class="rules-title">分销规则</text>
    </view>
    <view class="rules-body">
      <view class="rule-row">
        <view class="rule-dot"></view>
        <text class="rules-text">下级每消费20元，你可获得1.0积分（精确到0.1）</text>
      </view>
      <view class="rule-row">
        <view class="rule-dot"></view>
        <text class="rules-text">积分自动到账，无上限</text>
      </view>
    </view>
  </view>

  <!-- Share button -->
  <button class="share-btn" open-type="share">
    <view class="share-inner">
      <text class="share-icon">📤</text>
      <text class="share-text">分享给好友，自动绑定推荐关系</text>
    </view>
  </button>

  <!-- Referral points section -->
  <view class="section container">
    <view class="section-header">
      <text class="title">💰 分销积分记录</text>
    </view>

    <view class="points-list" wx:if="{{referralPoints.length > 0}}">
      <view class="record-item" wx:for="{{referralPoints}}" wx:key="_id">
        <view class="record-left">
          <view class="record-icon-wrap">
            <text class="record-icon">💎</text>
          </view>
          <view class="record-info">
            <text class="detail">下级消费 ¥{{item.amount}}</text>
            <text class="time">{{item.createTimeShort}}</text>
          </view>
        </view>
        <view class="record-right">
          <text class="change">+{{f.formatPoints(item.points)}}</text>
          <text class="change-unit">积分</text>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{referralPoints.length === 0 && !loading}}">
      <text class="emoji">💰</text>
      <text class="text">还没有分销积分，推荐越多赚得越多</text>
    </view>
  </view>
</view>
