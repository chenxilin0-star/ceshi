/* ===================================================
   Login Page - Dreamy Candy Theme
   Soft macaron pinks, warm purple-grays, fluffy cards
   =================================================== */

/* --- Page Container --- */
.page-login {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #FFF2F7 0%, #F8F3FA 100%);
  position: relative;
}

/* Soft ambient glow behind the card */
.page-login::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -55%);
  width: 500rpx;
  height: 500rpx;
  background: radial-gradient(
    circle,
    rgba(255, 126, 179, 0.12) 0%,
    rgba(179, 136, 255, 0.06) 50%,
    rgba(255, 255, 255, 0) 70%
  );
  border-radius: 50%;
  pointer-events: none;
}

/* --- Login Card --- */
.login-card {
  width: 600rpx;
  padding: 64rpx 48rpx;
  background: #FFFFFF;
  border-radius: 36rpx;
  box-shadow: 0 12rpx 48rpx rgba(255, 126, 179, 0.15),
              0 4rpx 16rpx rgba(179, 136, 255, 0.08);
  border: 1rpx solid var(--color-border-light, #F8F3FA);
  text-align: center;
  position: relative;
  z-index: 1;
}

/* --- Title --- */
.login-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text-primary, #3D3046);
  display: block;
  letter-spacing: 1rpx;
}

.login-subtitle {
  font-size: 26rpx;
  color: var(--color-text-tertiary, #A99BB2);
  margin-top: 12rpx;
  display: block;
  letter-spacing: 0.5rpx;
}

/* --- Avatar Section --- */
.avatar-section {
  margin: 48rpx 0 32rpx;
  display: flex;
  justify-content: center;
}

/* Avatar button - override WeChat button defaults */
.avatar-btn {
  display: block !important;
  width: 160rpx !important;
  height: 160rpx !important;
  min-width: 0 !important;
  max-width: 160rpx !important;
  border-radius: 50% !important;
  padding: 0 !important;
  margin: 0 auto !important;
  margin-left: auto !important;
  margin-right: auto !important;
  border: 4rpx dashed #E8D5EE !important;
  background: #FAF5FC !important;
  overflow: hidden;
  line-height: 152rpx;
  text-align: center;
  font-size: 0;
  box-sizing: border-box;
  box-shadow: 0 4rpx 16rpx rgba(212, 168, 255, 0.10);
  transition: border-color 0.3s ease, box-shadow 0.3s ease;
}

.avatar-btn::after {
  border: none !important;
}

.avatar-btn:active {
  border-color: var(--color-primary, #FF7EB3) !important;
  box-shadow: 0 4rpx 20rpx rgba(255, 126, 179, 0.2);
}

.avatar-img {
  width: 152rpx;
  height: 152rpx;
  border-radius: 50%;
  vertical-align: middle;
  box-shadow: 0 2rpx 12rpx rgba(255, 126, 179, 0.1);
}

.avatar-placeholder {
  width: 152rpx;
  height: 152rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-placeholder-text {
  font-size: 56rpx;
  color: #C9AED4;
  font-weight: 300;
  line-height: 1;
}

/* --- Nickname Section --- */
.nickname-section {
  margin-bottom: 40rpx;
}

.nickname-input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid var(--color-border, #F0E8F3);
  border-radius: 28rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  color: var(--color-text-primary, #3D3046);
  background: #FDFAFE;
  box-sizing: border-box;
  transition: border-color 0.3s ease, box-shadow 0.3s ease;
}

.nickname-input:focus {
  border-color: var(--color-primary, #FF7EB3);
  box-shadow: 0 0 0 6rpx rgba(255, 126, 179, 0.1);
  background: #FFFFFF;
}

.nickname-input::placeholder {
  color: var(--color-text-tertiary, #A99BB2);
}

/* --- Login Button --- */
.login-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #FF7EB3, #D4578A);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 126, 179, 0.3),
              0 2rpx 8rpx rgba(212, 87, 138, 0.15);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  position: relative;
  overflow: hidden;
}

/* Soft shine on the button */
.login-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 50%;
  background: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0.2) 0%,
    rgba(255, 255, 255, 0) 100%
  );
  border-radius: 44rpx 44rpx 0 0;
  pointer-events: none;
}

.login-btn:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 20rpx rgba(255, 126, 179, 0.25);
}

/* --- Disabled State --- */
.login-btn.disabled {
  background: #E0D4E6;
  box-shadow: none;
  color: rgba(255, 255, 255, 0.7);
}

.login-btn.disabled::before {
  display: none;
}

.login-btn.disabled:active {
  transform: none;
}

/* --- Agreement Text --- */
.agreement {
  margin-top: 32rpx;
  font-size: 22rpx;
  color: var(--color-text-tertiary, #A99BB2);
  line-height: 1.6;
}

.agreement-link {
  color: var(--color-primary, #FF7EB3);
  font-weight: 500;
}
