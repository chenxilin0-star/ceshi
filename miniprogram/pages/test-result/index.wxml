<view class="page-test-result">
  <!-- Loading -->
  <view class="loading-state" wx:if="{{loading}}">
    <view class="loading-orbit">
      <view class="loading-planet">✨</view>
      <view class="loading-dot dot-a"></view>
      <view class="loading-dot dot-b"></view>
    </view>
    <text class="loading-title">正在生成你的专属报告</text>
    <text class="loading-text">正在整理选择线索、人格关键词和今日建议…</text>
  </view>

  <!-- Result content -->
  <view class="result-content {{result.resultTheme.gradientClass}}" wx:if="{{!loading && result}}">
    <!-- Report cover -->
    <view class="report-hero">
      <view class="hero-bg hero-bg-a"></view>
      <view class="hero-bg hero-bg-b"></view>
      <view class="report-topline">
        <view class="report-type">
          <text class="type-icon">{{result.resultTheme.icon}}</text>
          <text>{{result.resultTheme.name}}</text>
        </view>
        <text class="report-status">已生成</text>
      </view>
      <view class="avatar-orb">
        <text class="result-badge">{{result.resultEmoji || '🌟'}}</text>
      </view>
      <text class="hero-kicker">你的{{result.testTitle}}结果是</text>
      <text class="result-title">{{result.resultTitle}}</text>
      <text class="share-line">{{result.shareLine}}</text>
      <view class="tag-row">
        <view class="result-tag" wx:for="{{result.resultTags}}" wx:key="*this">#{{item}}</view>
      </view>
    </view>

    <!-- Snapshot card -->
    <view class="snapshot-card">
      <view class="snapshot-item main-score">
        <text class="snapshot-num">{{result.matchPercent}}</text>
        <text class="snapshot-label">结果匹配度%</text>
      </view>
      <view class="snapshot-divider"></view>
      <view class="snapshot-item">
        <text class="snapshot-num small">{{result.questionCount || '-'}}</text>
        <text class="snapshot-label">答题题数</text>
      </view>
      <view class="snapshot-divider"></view>
      <view class="snapshot-item wide">
        <text class="snapshot-name">{{result.dominantTrait}}</text>
        <text class="snapshot-label">主导特征</text>
      </view>
    </view>

    <!-- Summary -->
    <view class="report-card summary-card">
      <view class="section-head">
        <view>
          <text class="section-kicker">REPORT 01</text>
          <text class="section-title">专属结果解读</text>
        </view>
        <text class="section-icon">🪐</text>
      </view>
      <text class="summary-text">{{result.summaryText}}</text>
    </view>

    <!-- Insight cards -->
    <view class="report-card insights-card">
      <view class="section-head compact">
        <view>
          <text class="section-kicker">REPORT 02</text>
          <text class="section-title">为什么会是这个结果</text>
        </view>
      </view>
      <view class="insight-list">
        <view class="insight-item" wx:for="{{result.insightCards}}" wx:key="title">
          <view class="insight-icon">{{item.icon}}</view>
          <view class="insight-copy">
            <text class="insight-title">{{item.title}}</text>
            <text class="insight-text">{{item.text}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="report-card evidence-card" wx:if="{{result.reasonList && result.reasonList.length}}">
      <view class="section-head compact">
        <view>
          <text class="section-kicker">EVIDENCE</text>
          <text class="section-title">选择线索</text>
        </view>
      </view>
      <view class="evidence-list">
        <view class="evidence-item" wx:for="{{result.reasonList}}" wx:key="*this">
          <text class="evidence-dot">●</text>
          <text class="evidence-text">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- Trait bars -->
    <view class="report-card trait-card">
      <view class="section-head compact">
        <view>
          <text class="section-kicker">REPORT 03</text>
          <text class="section-title">状态指数面板</text>
        </view>
      </view>
      <view class="trait-list">
        <view class="trait-item" wx:for="{{result.traitBars}}" wx:key="label">
          <view class="trait-row">
            <text class="trait-label">{{item.label}}</text>
            <text class="trait-value">{{item.value}}%</text>
          </view>
          <view class="trait-track">
            <view class="trait-fill {{item.tone}}" style="width: {{item.value}}%;"></view>
          </view>
        </view>
      </view>
    </view>

    <!-- Actions -->
    <view class="report-card compare-card">
      <view class="section-head compact">
        <view>
          <text class="section-kicker">REPORT 04</text>
          <text class="section-title">你的优势与提醒</text>
        </view>
      </view>
      <view class="compare-grid">
        <view class="compare-box good">
          <text class="compare-title">优势</text>
          <view class="compare-row" wx:for="{{result.strengthList}}" wx:key="*this">{{item}}</view>
        </view>
        <view class="compare-box warn">
          <text class="compare-title">注意</text>
          <view class="compare-row" wx:for="{{result.riskList}}" wx:key="*this">{{item}}</view>
        </view>
      </view>
    </view>

    <!-- Actions -->
    <view class="report-card action-plan-card">
      <view class="section-head compact">
        <view>
          <text class="section-kicker">REPORT 05</text>
          <text class="section-title">可执行建议</text>
        </view>
        <text class="section-icon">💡</text>
      </view>
      <view class="action-list">
        <view class="action-plan-item" wx:for="{{result.actionList}}" wx:key="text">
          <text class="action-icon">{{item.icon}}</text>
          <text class="action-text">{{item.text}}</text>
        </view>
      </view>
    </view>

    <view class="disclaimer-card">
      <text>本结果基于你的选择生成，仅用于校园娱乐和生活参考，不代表正式结论，也不会定义真实的你。</text>
    </view>

    <!-- Buttons -->
    <view class="action-buttons">
      <view class="btn-primary" bindtap="retryTest">再测一次，看看会不会变</view>
      <view class="btn-outline" bindtap="goHome">回到首页继续探索</view>
      <button class="btn-share" open-type="share">分享我的结果卡</button>
    </view>
  </view>

  <!-- Empty state -->
  <view class="empty-state" wx:if="{{!loading && !result}}">
    <view class="empty-planet">🪐</view>
    <text class="empty-title">没有找到测试报告</text>
    <text class="empty-text">可能是结果已过期，回到首页重新测一次吧。</text>
    <view class="btn-primary btn-back" bindtap="goHome">回到首页</view>
  </view>
</view>
