/* Product List Page - Dreamy Candy Theme */

.page-product-list {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding-bottom: 120rpx;
}

/* Points Bar */
.points-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx;
  margin: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 126, 179, 0.08);
  border: 1rpx solid var(--color-border-light);
}

.points-bar .label {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.points-bar .value {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFB74D;
}

/* Product Grid */
.product-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 16rpx;
  gap: 24rpx;
}

/* Product Card */
.product-card {
  width: calc(50% - 12rpx);
  background: #FFFFFF;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(255, 126, 179, 0.08);
  border: 1rpx solid var(--color-border-light);
  transition: all 0.2s ease;
}

.product-card:active {
  transform: scale(0.98);
}

.product-image {
  width: 100%;
  height: 280rpx;
  display: block;
}

.product-info {
  padding: 20rpx 24rpx;
}

.product-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

.product-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}

.product-points {
  font-size: 28rpx;
  font-weight: 700;
  color: #FFB74D;
}

.product-remain {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

/* Product Card Primary Button - override global width:100% */
.product-card .btn-primary {
  width: auto;
  display: block;
  margin: 0 24rpx 24rpx;
  font-size: 24rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 32rpx;
  background: linear-gradient(135deg, #FF7EB3, #D4578A);
  color: #FFFFFF;
  border-radius: 999rpx;
  text-align: center;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(255, 126, 179, 0.25);
  transition: all 0.2s ease;
}

.product-card .btn-primary:active {
  transform: scale(0.97);
  opacity: 0.9;
}
