/* ============================================
   Merchant Verify - Dreamy Candy Style
   梦幻糖果风 · 核销验证
   ============================================ */

/* --- Page Container --- */
.page-verify {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding: 32rpx;
  padding-bottom: 120rpx;
}

/* --- Verify Card --- */
.verify-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 40rpx;
  box-shadow: 0 6rpx 24rpx rgba(255, 126, 179, 0.08),
              0 2rpx 8rpx rgba(179, 136, 255, 0.04);
  border: 1rpx solid rgba(255, 126, 179, 0.06);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: 24rpx;
}

/* --- Input Row --- */
.input-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.code-input {
  flex: 1;
  height: 88rpx;
  padding: 0 24rpx;
  background: var(--color-bg-page);
  border-radius: 20rpx;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  text-transform: uppercase;
  color: var(--color-text-primary);
  border: 2rpx solid var(--color-border);
  transition: border-color 0.3s ease, box-shadow 0.3s ease;
}

.code-input:focus {
  border-color: var(--color-primary);
  box-shadow: 0 0 0 4rpx rgba(255, 126, 179, 0.1);
}

/* --- Scan Button --- */
.btn-scan {
  width: 120rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: var(--color-primary-light);
  color: var(--color-primary);
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 500;
  transition: transform 0.2s ease;
}

.btn-scan:active {
  transform: scale(0.95);
  background: rgba(255, 126, 179, 0.15);
}

/* --- Result Card --- */
.result-card {
  margin-top: 32rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 40rpx;
  text-align: center;
  box-shadow: 0 6rpx 24rpx rgba(255, 126, 179, 0.08),
              0 2rpx 8rpx rgba(179, 136, 255, 0.04);
  border: 1rpx solid rgba(255, 126, 179, 0.06);
  animation: fadeInUp 0.4s ease;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.result-card.success {
  border-top: 8rpx solid var(--color-success);
}

.result-card.fail {
  border-top: 8rpx solid var(--color-danger);
}

.result-icon {
  font-size: 64rpx;
  display: block;
  margin-bottom: 16rpx;
}

.result-card.success .result-icon {
  color: var(--color-success);
}

.result-card.fail .result-icon {
  color: var(--color-danger);
}

.result-msg {
  font-size: 32rpx;
  font-weight: 600;
  display: block;
  color: var(--color-text-primary);
}

.result-product {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  margin-top: 12rpx;
  display: block;
}
