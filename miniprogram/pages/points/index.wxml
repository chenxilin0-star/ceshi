<wxs src="../../utils/filters.wxs" module="f" />
<view class="page-points">
  <!-- Hero header -->
  <view class="points-hero">
    <view class="hero-bg hero-bg-one"></view>
    <view class="hero-bg hero-bg-two"></view>
    <view class="hero-inner">
      <text class="label">我的积分</text>
      <text class="value">{{f.formatPoints(userInfo.totalPoints)}}</text>
      <text class="rule">每消费10元 = 1.0积分（精确到0.1）</text>
      <view class="action" bindtap="goProductList">
        <text>去兑换商品</text>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>

  <!-- Upload receipt section -->
  <view class="upload-section card">
    <view class="section-header">
      <text class="title">📤 上传消费凭证</text>
    </view>

    <!-- 未选择照片时显示选择按钮 -->
    <view class="camera-area" wx:if="{{!tempFilePath}}" bindtap="takePhoto">
      <view class="camera-ring">
        <text class="camera-icon">📷</text>
      </view>
      <text class="camera-text">拍摄或选择账单详情原图</text>
      <text class="camera-sub">支持拍照或从相册选择"全部账单/账单详情"页面，金额需在5-100元</text>
    </view>

    <!-- 已拍照显示预览 -->
    <view class="preview-area" wx:if="{{tempFilePath}}">
      <image class="preview-image" src="{{tempFilePath}}" mode="aspectFit"></image>
    </view>

    <!-- 识别中 -->
    <view class="recognizing-status" wx:if="{{recognizing}}">
      <view class="loading-ring">
        <text class="loading-icon">⏳</text>
      </view>
      <text class="loading-text">正在识别中…</text>
    </view>

    <!-- 识别结果展示 -->
    <view class="ocr-result" wx:if="{{ocrResult}}">
      <view class="result-header">
        <text class="result-title">识别结果</text>
        <view class="result-badge {{ocrResult.parsed.valid ? 'badge-success' : 'badge-error'}}">
          {{ocrResult.parsed.valid ? '验证通过' : '验证不通过'}}
        </view>
      </view>

      <view class="result-body">
        <view class="result-field">
          <text class="field-label">商品</text>
          <text class="field-value">{{ocrResult.parsed.product || '未识别'}}</text>
        </view>
        <view class="result-field">
          <text class="field-label">消费金额</text>
          <text class="field-value">¥{{ocrResult.parsed.amount || '0.00'}}</text>
        </view>
        <view class="result-field">
          <text class="field-label">支付时间</text>
          <text class="field-value">{{ocrResult.parsed.payTime || '未识别'}}</text>
        </view>
      </view>

      <!-- 预计获得积分 -->
      <view class="points-preview" wx:if="{{ocrResult.parsed.valid}}">
        <text class="preview-label">预计获得</text>
        <text class="points-num">{{f.formatPoints(ocrResult.parsed.pointsPreview)}}</text>
        <text class="preview-unit">积分</text>
      </view>

      <!-- 操作按钮 -->
      <view class="result-actions">
        <view class="btn-secondary" bindtap="retakePhoto">重新选择</view>
        <view class="btn-primary {{ocrResult.parsed.valid ? '' : 'disabled'}}" bindtap="submitReceipt">
          {{submitting ? '提交中…' : '确认获取积分'}}
        </view>
      </view>
    </view>
  </view>

  <!-- Receipt history -->
  <view class="history-section container">
    <view class="section-header">
      <text class="title">🧾 最近记录</text>
    </view>

    <view class="receipt-list" wx:if="{{receipts.length > 0}}">
      <view class="receipt-item" wx:for="{{receipts}}" wx:key="_id">
        <view class="receipt-icon-wrap">
          <text class="icon">🧾</text>
        </view>
        <view class="info">
          <text class="amount">¥{{item.amount}}</text>
          <text class="date">{{item.createTimeShort}}</text>
        </view>
        <view class="points-wrap">
          <text class="points">+{{f.formatPoints(item.pointsEarned)}}</text>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{receipts.length === 0 && !loading}}">
      <text class="emoji">🧾</text>
      <text class="text">还没有消费记录，快去上传第一笔吧！</text>
    </view>
  </view>
</view>
