/* Points Page - Dreamy Candy Theme */

.page-points {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding-bottom: 120rpx;
}

/* ========== Hero Header ========== */
.points-hero {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #FF7EB3 0%, #B388FF 60%, #82B1FF 100%);
  border-radius: 0 0 48rpx 48rpx;
  padding: 56rpx 32rpx 64rpx;
  text-align: center;
  color: #FFFFFF;
  box-shadow: 0 18rpx 50rpx rgba(127, 86, 217, 0.22);
}

.hero-bg {
  position: absolute;
  border-radius: 999rpx;
  opacity: 0.22;
  pointer-events: none;
}

.hero-bg-one {
  width: 280rpx;
  height: 280rpx;
  right: -80rpx;
  top: -40rpx;
  background: #FFFFFF;
}

.hero-bg-two {
  width: 200rpx;
  height: 200rpx;
  left: -60rpx;
  bottom: -20rpx;
  background: #FFE066;
}

.hero-inner {
  position: relative;
  z-index: 1;
}

.points-hero .label {
  font-size: 26rpx;
  opacity: 0.85;
  display: block;
  letter-spacing: 2rpx;
}

.points-hero .value {
  font-size: 96rpx;
  font-weight: 700;
  margin: 16rpx 0;
  display: block;
  letter-spacing: -2rpx;
  text-shadow: 0 6rpx 20rpx rgba(88, 49, 148, 0.28);
}

.points-hero .rule {
  font-size: 22rpx;
  opacity: 0.75;
  display: block;
}

.points-hero .action {
  display: inline-flex;
  align-items: center;
  margin-top: 28rpx;
  padding: 12rpx 32rpx;
  background: rgba(255, 255, 255, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.38);
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #FFFFFF;
  transition: all 0.2s ease;
}

.points-hero .action:active {
  background: rgba(255, 255, 255, 0.35);
  transform: scale(0.97);
}

.points-hero .action .arrow {
  margin-left: 8rpx;
  font-size: 28rpx;
  opacity: 0.9;
}

/* ========== Upload Section ========== */
.upload-section {
  margin: 32rpx;
}

.upload-section .section-header {
  margin-bottom: 20rpx;
}

.upload-section .section-header .title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

/* ========== Camera Area ========== */
.camera-area {
  padding: 72rpx 40rpx;
  border: 2rpx dashed #E8D5EE;
  border-radius: 28rpx;
  text-align: center;
  background: #FFFFFF;
  transition: all 0.2s ease;
}

.camera-area:active {
  background: var(--color-primary-light);
  border-color: var(--color-primary);
}

.camera-ring {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFF2F7, #F3EAFF);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 126, 179, 0.12);
}

.camera-icon {
  font-size: 56rpx;
  display: block;
}

.camera-text {
  font-size: 30rpx;
  color: var(--color-text-primary);
  font-weight: 600;
  display: block;
}

.camera-sub {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-top: 12rpx;
  display: block;
  line-height: 1.5;
}

/* ========== Image Preview ========== */
.preview-area {
  text-align: center;
}

.preview-image {
  width: 100%;
  max-height: 480rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

/* ========== Recognizing Status ========== */
.recognizing-status {
  padding: 48rpx;
  text-align: center;
}

.loading-ring {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFF2F7, #F3EAFF);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16rpx;
  animation: pulse 1.6s ease-in-out infinite;
}

.loading-icon {
  font-size: 48rpx;
  display: block;
}

.loading-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

/* ========== OCR Result ========== */
.ocr-result {
  margin-top: 24rpx;
  padding: 28rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: var(--shadow-card);
  border: 1rpx solid rgba(255, 126, 179, 0.06);
  animation: fadeInUp 0.35s ease;
}

.ocr-result .result-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.ocr-result .result-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.ocr-result .result-badge {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-weight: 500;
}

.result-body {
  background: var(--color-bg-page);
  border-radius: 20rpx;
  padding: 8rpx 24rpx;
}

.result-field {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.result-field:last-child {
  border-bottom: none;
}

.field-label {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
}

.field-value {
  font-size: 26rpx;
  color: var(--color-text-primary);
  font-weight: 600;
}

/* ========== Points Preview ========== */
.points-preview {
  margin-top: 24rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #EEFBF5, #F0FFF4);
  border-radius: 20rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.preview-label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.points-num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-success);
  margin: 0 4rpx;
}

.preview-unit {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

/* ========== Result Actions ========== */
.result-actions {
  margin-top: 24rpx;
  display: flex;
  gap: 20rpx;
}

.result-actions .btn-secondary {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  background: #FFFFFF;
  border: 2rpx solid var(--color-border);
  border-radius: 999rpx;
  font-size: 28rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
  transition: all 0.2s ease;
}

.result-actions .btn-secondary:active {
  background: var(--color-bg-hover);
  border-color: var(--color-primary);
  color: var(--color-primary);
}

.result-actions .btn-primary {
  flex: 2;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 28rpx;
}

/* ========== History Section ========== */
.history-section {
  margin-top: 8rpx;
}

.history-section .section-header .title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

/* ========== Receipt List ========== */
.receipt-list {
  margin-top: 8rpx;
}

.receipt-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-card);
  border: 1rpx solid rgba(255, 126, 179, 0.06);
  transition: transform 0.15s ease;
}

.receipt-item:active {
  transform: scale(0.98);
}

.receipt-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #FFF2F7, #F3EAFF);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.receipt-item .icon {
  font-size: 36rpx;
}

.receipt-item .info {
  flex: 1;
}

.receipt-item .amount {
  font-size: 30rpx;
  color: var(--color-text-primary);
  font-weight: 600;
  display: block;
}

.receipt-item .date {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-top: 4rpx;
  display: block;
}

.points-wrap {
  flex-shrink: 0;
  background: linear-gradient(135deg, #EEFBF5, #F0FFF4);
  border-radius: 16rpx;
  padding: 10rpx 20rpx;
}

.receipt-item .points {
  font-size: 30rpx;
  color: var(--color-success);
  font-weight: 700;
}
