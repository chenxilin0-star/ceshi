/* Points Page - Dreamy Candy Theme */

.page-points {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding-bottom: 120rpx;
}

/* Points Header Card */
.points-card {
  background: linear-gradient(135deg, #FFC3F7, #D4A8FF);
  border-radius: 0 0 48rpx 48rpx;
  padding: 64rpx 48rpx;
  text-align: center;
  color: #FFFFFF;
}

.points-card .label {
  font-size: 28rpx;
  opacity: 0.85;
  display: block;
}

.points-card .value {
  font-size: 96rpx;
  font-weight: 700;
  margin: 24rpx 0;
  display: block;
  letter-spacing: -2rpx;
}

.points-card .rule {
  font-size: 24rpx;
  opacity: 0.7;
  display: block;
}

.points-card .action {
  display: inline-flex;
  align-items: center;
  margin-top: 32rpx;
  padding: 12rpx 32rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #FFFFFF;
}

/* Upload Section */
.upload-section {
  margin: 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: 24rpx;
}

/* Camera Area */
.camera-area {
  padding: 80rpx 48rpx;
  border: 2rpx dashed #E8D5EE;
  border-radius: 28rpx;
  text-align: center;
  background: #FFFFFF;
  transition: all 0.2s ease;
}

.camera-area:active {
  background: var(--color-primary-light);
}

.camera-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.camera-text {
  font-size: 30rpx;
  color: var(--color-text-primary);
  font-weight: 600;
  display: block;
}

.camera-sub {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  margin-top: 12rpx;
  display: block;
}

/* Image Preview */
.preview-area {
  text-align: center;
}

.preview-image {
  width: 100%;
  max-height: 500rpx;
  border-radius: 20rpx;
}

.preview-actions {
  margin-top: 24rpx;
  display: flex;
  justify-content: center;
}

.btn-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 48rpx;
  border: 1rpx solid var(--color-border-light);
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  background: #FFFFFF;
}

/* Recognizing Status */
.recognizing-status {
  padding: 40rpx;
  text-align: center;
}

.loading-icon {
  font-size: 48rpx;
  display: block;
  margin-bottom: 12rpx;
}

.loading-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

/* OCR Result */
.ocr-result {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #FAF5FC;
  border-radius: 20rpx;
}

.ocr-result .result-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.ocr-result .result-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.ocr-result .result-badge {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.badge-success {
  background: #EEFBF5;
  color: #69DBAF;
}

.badge-error {
  background: #FFF2F2;
  color: #FF7979;
}

.result-field {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F0E8F3;
}

.result-field:last-of-type {
  border-bottom: none;
}

.field-label {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
}

.field-value {
  font-size: 26rpx;
  color: var(--color-text-primary);
  font-weight: 600;
}

.field-error {
  color: #FF7979;
}

.field-mono {
  font-size: 22rpx;
  word-break: break-all;
}

/* Points Preview */
.points-preview {
  margin-top: 20rpx;
  padding: 20rpx;
  background: #EEFBF5;
  border-radius: 16rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.points-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #69DBAF;
  margin: 0 4rpx;
}

/* Result Actions */
.result-actions {
  margin-top: 24rpx;
  display: flex;
  gap: 20rpx;
}

.result-actions .btn-secondary {
  flex: 1;
}

.result-actions .btn-primary {
  flex: 2;
  text-align: center;
}

/* Result Errors */
.result-errors {
  margin-top: 20rpx;
  padding: 16rpx;
  background: #FFF2F2;
  border-radius: 16rpx;
}

.error-title {
  font-size: 24rpx;
  color: #FF7979;
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}

.error-item {
  font-size: 22rpx;
  color: #FF7979;
  display: block;
  line-height: 1.6;
}

/* Raw Text */
.raw-text-section {
  margin-top: 20rpx;
  padding: 16rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  border: 1rpx solid var(--color-border-light);
}

.raw-text-title {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  display: block;
  margin-bottom: 8rpx;
}

.raw-text-content {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  white-space: pre-wrap;
  word-break: break-all;
  display: block;
  line-height: 1.8;
}

/* History Section */
.history-section {
  margin-top: 16rpx;
}

/* Receipt List */
.receipt-list {
  margin-top: 16rpx;
}

.receipt-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 126, 179, 0.08);
  border: 1rpx solid var(--color-border-light);
}

.receipt-item .icon {
  font-size: 40rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.receipt-item .info {
  flex: 1;
}

.receipt-item .amount {
  font-size: 30rpx;
  color: var(--color-text-primary);
  font-weight: 600;
  display: block;
}

.receipt-item .date {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-top: 4rpx;
  display: block;
}

.receipt-item .points {
  font-size: 32rpx;
  color: #69DBAF;
  font-weight: 700;
  flex-shrink: 0;
}
