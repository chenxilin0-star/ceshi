/* ============================================
   Merchant Verify Log - Dreamy Candy Style
   梦幻糖果风 · 核销记录
   ============================================ */

/* --- Page Container --- */
.page-verify-log {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding-bottom: 120rpx;
}

/* --- Log List --- */
.log-list {
  padding: 32rpx;
}

/* --- Log Item Card --- */
.log-item {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(255, 126, 179, 0.08),
              0 2rpx 8rpx rgba(179, 136, 255, 0.04);
  border: 1rpx solid rgba(255, 126, 179, 0.06);
  transition: background 0.2s ease;
}

.log-item:active {
  background: var(--color-bg-hover);
}

/* --- Log Header --- */
.log-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.log-product {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  margin-right: 16rpx;
}

.log-time {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  flex-shrink: 0;
}

/* --- Log Meta --- */
.log-meta {
  margin-top: 12rpx;
}

.log-code {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  font-family: 'Courier New', 'SFMono-Regular', Consolas, monospace;
  letter-spacing: 4rpx;
  background: var(--color-bg-page);
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
}
