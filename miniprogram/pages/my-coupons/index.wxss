/* ========================================
   My Coupons - Dreamy Candy Theme
   Coupon cards with peach-tinted top strip,
   soft macaron pinks, fluffy rounded cards
   ======================================== */

/* ========== Page Container ========== */
.page-my-coupons {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding-bottom: 120rpx;
}

/* ========== Tab Switch ========== */
.tab-switch {
  display: flex;
  padding: 0 32rpx;
  margin-bottom: 32rpx;
  background: #FFFFFF;
  border-bottom: 2rpx solid rgba(255, 126, 179, 0.1);
  position: relative;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: var(--color-text-tertiary);
  border-bottom: 4rpx solid transparent;
  position: relative;
  transition: all 0.3s ease;
}

.tab-item.active {
  color: var(--color-primary);
  font-weight: var(--weight-medium);
  border-bottom-color: transparent;
}

/* Gradient underline for active tab */
.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: -2rpx;
  left: 25%;
  right: 25%;
  height: 6rpx;
  background: var(--gradient-primary);
  border-radius: 3rpx;
}

/* ========== Coupon List ========== */
.coupon-list {
  padding: 0 32rpx;
}

/* Coupon card with peach gradient top strip */
.coupon-item {
  background: #FFFFFF;
  border-radius: var(--radius-lg);
  padding: 40rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
  border: 1rpx solid rgba(255, 126, 179, 0.06);
  position: relative;
  overflow: hidden;
  transition: transform 0.2s ease;
}

/* Peach-tinted top accent strip via pseudo-element */
.coupon-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 8rpx;
  background: var(--gradient-peach);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
}

/* Coupon header - name on left, face value on right */
.coupon-item .header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.coupon-item .name {
  font-size: 36rpx;
  font-weight: var(--weight-bold);
  color: var(--color-text-primary);
  display: block;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.coupon-item .expiry {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  margin-top: 8rpx;
  display: block;
}

/* Face value in warm accent color */
.face-value {
  font-size: 40rpx;
  font-weight: var(--weight-bold);
  color: var(--color-accent);
  flex-shrink: 0;
  margin-left: 24rpx;
  text-shadow: 0 2rpx 8rpx rgba(255, 183, 77, 0.15);
}

/* ========== Verify Code Section ========== */
.verify-section {
  margin-top: 32rpx;
  padding-top: 32rpx;
  border-top: 2rpx dashed var(--color-border);
  text-align: center;
}

.verify-label {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  margin-bottom: 16rpx;
  display: block;
}

/* Large monospace verify code with dreamy pink glow */
.verify-code {
  font-family: 'Courier New', 'SFMono-Regular', Consolas, monospace;
  font-size: 72rpx;
  font-weight: var(--weight-bold);
  color: var(--color-primary);
  letter-spacing: 16rpx;
  text-align: center;
  display: block;
  margin: 16rpx 0;
  text-shadow: 0 2rpx 16rpx rgba(255, 126, 179, 0.15);
}

.verify-code.masked {
  letter-spacing: 8rpx;
}

/* Show/hide toggle - soft pill button */
.btn-show {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  padding: 20rpx 32rpx;
  background: var(--color-primary-light);
  color: var(--color-primary);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  font-weight: var(--weight-medium);
  transition: all 0.2s ease;
}

.btn-show:active {
  background: rgba(255, 126, 179, 0.15);
  transform: scale(0.98);
}

/* ========== Used / Expired Status ========== */
.used-info {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx dashed var(--color-border);
  text-align: center;
}

.used-text {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  display: block;
}

.expired-info {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx dashed var(--color-border);
  text-align: center;
}

.expired-text {
  font-size: 26rpx;
  color: var(--color-danger);
  display: block;
}
