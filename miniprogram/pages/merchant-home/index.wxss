/* ============================================
   Merchant Home - Dreamy Candy Style
   梦幻糖果风 · 商户首页
   ============================================ */

/* --- Page Container --- */
.page-merchant-home {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding-bottom: 120rpx;
  position: relative;
}

/* --- Header with Lilac Gradient --- */
.header {
  background: var(--gradient-lilac);
  padding: 64rpx 32rpx;
  border-radius: 0 0 48rpx 48rpx;
  position: relative;
  overflow: hidden;
}

.header::before {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  pointer-events: none;
}

.header::after {
  content: '';
  position: absolute;
  bottom: -20rpx;
  left: 40rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  pointer-events: none;
}

.header-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: block;
  text-shadow: 0 2rpx 8rpx rgba(180, 100, 200, 0.3);
  position: relative;
  z-index: 1;
}

.header-sub {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
  display: block;
  position: relative;
  z-index: 1;
}

/* --- Action Grid --- */
.action-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 32rpx;
  gap: 24rpx;
}

/* --- Action Card --- */
.action-card {
  width: calc(50% - 12rpx);
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 6rpx 24rpx rgba(255, 126, 179, 0.08),
              0 2rpx 8rpx rgba(179, 136, 255, 0.04);
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 1rpx solid rgba(255, 126, 179, 0.06);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.action-card:active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 12rpx rgba(255, 126, 179, 0.12);
}

.action-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
  line-height: 1;
}

.action-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: 8rpx;
  text-align: center;
}

.action-desc {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  text-align: center;
  line-height: 1.5;
}
