/* ============================================
   Merchant Home - Premium Dashboard UI
   梦幻糖果风 · 商户经营工作台
   ============================================ */

.page-merchant-home {
  min-height: 100vh;
  background: linear-gradient(180deg, #F7F3FF 0%, #FBF6FD 42%, #FFF8FB 100%);
  padding-bottom: 120rpx;
  color: var(--color-text-primary);
  position: relative;
  overflow: hidden;
}

.page-merchant-home::before {
  content: '';
  position: absolute;
  top: 220rpx;
  right: -140rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: rgba(255, 126, 179, 0.08);
  pointer-events: none;
}

.page-merchant-home::after {
  content: '';
  position: absolute;
  top: 620rpx;
  left: -120rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: rgba(130, 177, 255, 0.08);
  pointer-events: none;
}

/* Loading */
.merchant-loading {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 1;
}

.loading-orbit {
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(255, 126, 179, 0.18), rgba(179, 136, 255, 0.18));
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 42rpx rgba(179, 136, 255, 0.18);
  animation: merchantPulse 1.8s ease-in-out infinite;
}

.loading-icon {
  font-size: 64rpx;
}

.loading-text {
  margin-top: 28rpx;
  color: var(--color-text-tertiary);
  font-size: 28rpx;
}

/* Hero */
.merchant-hero {
  position: relative;
  overflow: hidden;
  padding: 72rpx 32rpx 42rpx;
  background: linear-gradient(155deg, #7C5CFF 0%, #B388FF 46%, #FF7EB3 100%);
  border-radius: 0 0 52rpx 52rpx;
  box-shadow: 0 22rpx 60rpx rgba(124, 92, 255, 0.24);
}

.hero-bg {
  position: absolute;
  border-radius: 999rpx;
  pointer-events: none;
}

.hero-bg-one {
  width: 300rpx;
  height: 300rpx;
  top: -70rpx;
  right: -80rpx;
  background: rgba(255, 255, 255, 0.18);
}

.hero-bg-two {
  width: 180rpx;
  height: 180rpx;
  left: -54rpx;
  bottom: 78rpx;
  background: rgba(255, 224, 102, 0.22);
}

.hero-bg-three {
  width: 120rpx;
  height: 120rpx;
  right: 180rpx;
  bottom: 156rpx;
  background: rgba(130, 177, 255, 0.24);
}

.hero-top {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
}

.hero-kicker {
  display: inline-flex;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.20);
  border: 1rpx solid rgba(255, 255, 255, 0.34);
  color: rgba(255, 255, 255, 0.96);
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.hero-title {
  display: block;
  margin-top: 18rpx;
  color: #FFFFFF;
  font-size: 54rpx;
  line-height: 1.12;
  font-weight: 800;
  letter-spacing: 1rpx;
  text-shadow: 0 8rpx 22rpx rgba(88, 49, 148, 0.32);
}

.hero-sub {
  display: block;
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 26rpx;
  line-height: 1.5;
}

.hero-badge {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 118rpx;
  height: 118rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.34);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.30);
}

.hero-badge-icon {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: #69DBAF;
  color: #FFFFFF;
  font-size: 28rpx;
  line-height: 42rpx;
  text-align: center;
  font-weight: 800;
}

.hero-badge-text {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.92);
  font-size: 20rpx;
  font-weight: 600;
}

.hero-summary {
  position: relative;
  z-index: 1;
  margin-top: 44rpx;
  padding: 28rpx 20rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  display: flex;
  align-items: center;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.20);
}

.summary-item {
  flex: 1;
  text-align: center;
}

.summary-value {
  display: block;
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.1;
}

.summary-label {
  display: block;
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 22rpx;
}

.summary-divider {
  width: 1rpx;
  height: 54rpx;
  background: rgba(255, 255, 255, 0.22);
}

/* Workspace */
.workspace-section {
  position: relative;
  z-index: 1;
  margin: -18rpx 0 0;
  padding: 48rpx 32rpx 0;
}

.merchant-section-header {
  margin-bottom: 24rpx;
}

.section-kicker {
  display: block;
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.section-title {
  display: block;
  margin-top: 6rpx;
  color: var(--color-text-primary);
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.2;
}

.section-action {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #FFF2F7;
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 600;
}

.action-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 22rpx;
}

.action-card {
  width: calc(50% - 11rpx);
  min-height: 250rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.94);
  border-radius: 34rpx;
  padding: 30rpx 26rpx 26rpx;
  box-shadow: 0 12rpx 36rpx rgba(124, 92, 255, 0.08),
              0 4rpx 16rpx rgba(255, 126, 179, 0.08);
  border: 1rpx solid rgba(255, 126, 179, 0.08);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  transition: transform 0.18s ease, box-shadow 0.18s ease;
}

.action-card:active {
  transform: scale(0.97);
  box-shadow: 0 6rpx 22rpx rgba(124, 92, 255, 0.12);
}

.action-glow {
  position: absolute;
  right: -52rpx;
  top: -52rpx;
  width: 156rpx;
  height: 156rpx;
  border-radius: 50%;
  opacity: 0.78;
  pointer-events: none;
}

.card-products .action-glow { background: rgba(255, 126, 179, 0.18); }
.card-verify .action-glow { background: rgba(105, 219, 175, 0.20); }
.card-log .action-glow { background: rgba(130, 177, 255, 0.20); }
.card-lottery .action-glow { background: rgba(255, 183, 77, 0.20); }

.action-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FFF2F7, #F3EAFF);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
  position: relative;
  z-index: 1;
}

.action-icon {
  font-size: 48rpx;
  line-height: 1;
}

.action-copy {
  position: relative;
  z-index: 1;
  margin-top: 24rpx;
}

.action-title {
  display: block;
  color: var(--color-text-primary);
  font-size: 31rpx;
  font-weight: 800;
  line-height: 1.2;
}

.action-desc {
  display: block;
  margin-top: 10rpx;
  color: var(--color-text-tertiary);
  font-size: 23rpx;
  line-height: 1.45;
}

.action-arrow {
  position: absolute;
  right: 24rpx;
  bottom: 20rpx;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: rgba(255, 126, 179, 0.10);
  color: var(--color-primary);
  font-size: 34rpx;
  line-height: 38rpx;
  text-align: center;
  font-weight: 600;
}

/* Tips */
.tips-card {
  position: relative;
  z-index: 1;
  margin: 32rpx;
  padding: 28rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.96), rgba(255, 248, 238, 0.96));
  border: 1rpx solid rgba(255, 183, 77, 0.14);
  box-shadow: 0 10rpx 34rpx rgba(255, 183, 77, 0.10);
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.tips-icon-wrap {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: rgba(255, 183, 77, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
}

.tips-icon {
  font-size: 38rpx;
}

.tips-copy {
  flex: 1;
  min-width: 0;
}

.tips-title {
  display: block;
  color: var(--color-text-primary);
  font-size: 28rpx;
  font-weight: 800;
}

.tips-text {
  display: block;
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 1.65;
}

@keyframes merchantPulse {
  0%, 100% { transform: scale(1); opacity: 0.78; }
  50% { transform: scale(1.06); opacity: 1; }
}
