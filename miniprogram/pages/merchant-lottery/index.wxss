/* ============================================
   Merchant Lottery Config - Dreamy Candy Style
   ============================================ */

.page-merchant-lottery {
  min-height: 100vh;
  background: var(--color-bg-page, #FBF6FD);
  padding-bottom: 160rpx;
}

/* --- Header --- */
.header {
  background: var(--gradient-lilac, linear-gradient(135deg, #FFC3F7, #D4A8FF));
  padding: 64rpx 32rpx;
  border-radius: 0 0 48rpx 48rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: block;
}

.header-sub {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 8rpx;
  display: block;
}

/* --- Loading --- */
.loading-state {
  text-align: center;
  padding: 120rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #A99BB2;
}

/* --- Prize List --- */
.prize-list {
  padding: 24rpx 24rpx 0;
}

.prize-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 126, 179, 0.08);
}

.prize-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.prize-order {
  font-size: 30rpx;
  font-weight: 600;
  color: #3D3046;
}

.prize-enabled {
  display: flex;
  align-items: center;
}

/* --- Form Row --- */
.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F5F0F7;
}

.form-row:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 26rpx;
  color: #6E5F77;
  min-width: 100rpx;
}

.form-input {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: #3D3046;
  padding: 8rpx 0;
}

/* --- Type Display --- */
.type-display {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.type-tag {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  font-weight: 500;
}

.type-tag.points {
  background: #E8F8F5;
  color: #3CB58A;
}

.type-tag.product {
  background: #E3F2FD;
  color: #5C9CE6;
}

.type-tag.none {
  background: #F3E5F5;
  color: #B388FF;
}

.arrow {
  font-size: 28rpx;
  color: #C4B5CF;
}

/* --- Product Select --- */
.product-select {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.product-name {
  font-size: 26rpx;
  color: #3D3046;
}

/* --- Probability Summary --- */
.prob-summary {
  margin: 24rpx 24rpx 0;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(255, 126, 179, 0.08);
}

.prob-text {
  font-size: 32rpx;
  font-weight: 700;
  display: block;
}

.prob-text.ok {
  color: #3CB58A;
}

.prob-text.error {
  color: #FF6B9D;
}

.prob-hint {
  font-size: 24rpx;
  color: #A99BB2;
  margin-top: 4rpx;
  display: block;
}

/* --- Save Button --- */
.save-section {
  padding: 32rpx 48rpx;
}

.save-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #FF7EB3, #D4578A);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(255, 126, 179, 0.3);
}

.save-btn.disabled {
  background: #E0D4E6;
  box-shadow: none;
}

/* --- Picker Mask --- */
.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(61, 48, 70, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.picker-card {
  width: 600rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 40rpx 32rpx;
  max-height: 70vh;
}

.picker-card-large {
  width: 640rpx;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #3D3046;
  display: block;
  text-align: center;
  margin-bottom: 24rpx;
}

.picker-option {
  padding: 24rpx 20rpx;
  border-bottom: 1rpx solid #F5F0F7;
}

.picker-option:last-of-type {
  border-bottom: none;
}

.picker-option-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #3D3046;
  display: block;
}

.picker-option-desc {
  font-size: 24rpx;
  color: #A99BB2;
  margin-top: 4rpx;
  display: block;
}

.picker-cancel {
  margin-top: 20rpx;
  text-align: center;
  font-size: 28rpx;
  color: #A99BB2;
  padding: 16rpx 0;
}

/* --- Product Scroll --- */
.product-scroll {
  max-height: 500rpx;
}

.product-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1rpx solid #F5F0F7;
}

.product-item-name {
  font-size: 28rpx;
  color: #3D3046;
  font-weight: 500;
}

.product-item-stock {
  font-size: 24rpx;
  color: #A99BB2;
}

.product-empty {
  text-align: center;
  padding: 60rpx 0;
  font-size: 26rpx;
  color: #A99BB2;
}
