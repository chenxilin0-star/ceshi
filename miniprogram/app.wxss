/* 趣测星球 - Dreamy Candy 全局样式 */

/* ========== CSS 变量 ========== */
page {
  /* 主色调 - 梦幻粉 */
  --color-primary: #FF7EB3;
  --color-primary-light: #FFF2F7;
  --color-primary-dark: #E8609A;
  --color-primary-secondary: #D4578A;

  /* 辅助色 */
  --color-secondary: #B388FF;
  --color-accent: #FFB74D;
  --color-success: #69DBAF;
  --color-warning: #FFE066;
  --color-danger: #FF7979;
  --color-blue: #82B1FF;

  /* 中性色 - 暖灰 */
  --color-text-primary: #3D3046;
  --color-text-secondary: #6E5F77;
  --color-text-tertiary: #A99BB2;
  --color-text-quaternary: #D0C4D6;
  --color-border: #F0E8F3;
  --color-border-light: #F8F3FA;
  --color-bg-page: #FBF6FD;
  --color-bg-card: #FFFFFF;
  --color-bg-hover: #FAF5FC;

  /* 渐变 */
  --gradient-primary: linear-gradient(135deg, #FF7EB3, #D4578A);
  --gradient-primary-light: linear-gradient(135deg, #FFA8C5, #FF7EB3);
  --gradient-dreamy: linear-gradient(135deg, #FFA8C5 0%, #B388FF 50%, #82B1FF 100%);
  --gradient-candy: linear-gradient(135deg, #FF7EB3, #FFB74D);
  --gradient-purple: linear-gradient(135deg, #B388FF, #D4578A);
  --gradient-orange: linear-gradient(90deg, #FFB74D, #FFDA8A);
  --gradient-peach: linear-gradient(135deg, #FFECD2, #FCB69F);
  --gradient-mint: linear-gradient(135deg, #A8EDCE, #F0FFF0);
  --gradient-lilac: linear-gradient(135deg, #FFC3F7, #D4A8FF);

  /* 字号 */
  --font-xs: 20rpx;
  --font-sm: 24rpx;
  --font-base: 28rpx;
  --font-md: 32rpx;
  --font-lg: 36rpx;
  --font-xl: 48rpx;
  --font-xxl: 60rpx;
  --font-display: 72rpx;

  /* 字重 */
  --weight-normal: 400;
  --weight-medium: 500;
  --weight-bold: 700;

  /* 行高 */
  --line-height-tight: 1.2;
  --line-height-normal: 1.5;
  --line-height-loose: 1.8;

  /* 间距 */
  --space-xs: 8rpx;
  --space-sm: 16rpx;
  --space-md: 24rpx;
  --space-lg: 32rpx;
  --space-xl: 48rpx;
  --space-xxl: 64rpx;

  /* 页面边距 */
  --page-padding: 32rpx;

  /* 圆角 - 更圆润 */
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 28rpx;
  --radius-xl: 36rpx;
  --radius-pill: 9999rpx;

  /* 阴影 - 柔粉色调 */
  --shadow-card: 0 4rpx 20rpx rgba(255, 126, 179, 0.08);
  --shadow-float: 0 8rpx 40rpx rgba(255, 126, 179, 0.15);
  --shadow-glow: 0 0 30rpx rgba(255, 126, 179, 0.2);

  /* 层级 */
  --z-base: 1;
  --z-dropdown: 100;
  --z-sticky: 200;
  --z-modal: 300;
  --z-toast: 400;

  background-color: var(--color-bg-page);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  color: var(--color-text-primary);
  font-size: var(--font-base);
  line-height: var(--line-height-normal);
}

/* ========== 页面容器 ========== */
.page {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding-bottom: 120rpx;
}

.container {
  padding-left: var(--page-padding);
  padding-right: var(--page-padding);
}

/* ========== 卡片 ========== */
.card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  margin-bottom: var(--space-md);
  box-shadow: var(--shadow-card);
  border: 1rpx solid rgba(255, 126, 179, 0.06);
}

/* ========== 按钮 ========== */
.btn-primary {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  background: var(--gradient-primary);
  color: #FFFFFF;
  font-size: var(--font-md);
  font-weight: var(--weight-medium);
  border-radius: var(--radius-pill);
  border: none;
  box-shadow: 0 8rpx 28rpx rgba(255, 126, 179, 0.35);
  letter-spacing: 2rpx;
}

.btn-primary:active {
  transform: scale(0.97);
  opacity: 0.9;
}

.btn-primary.disabled, .btn-primary[disabled] {
  background: #D8D0DC;
  box-shadow: none;
  color: #FFFFFF;
}

.btn-outline {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.8);
  color: var(--color-primary);
  font-size: var(--font-md);
  font-weight: var(--weight-medium);
  border-radius: var(--radius-pill);
  border: 2rpx solid var(--color-primary);
}

.btn-outline:active {
  background: var(--color-primary-light);
}

.btn-mini {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 28rpx;
  background: var(--gradient-primary);
  color: #FFFFFF;
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
  border-radius: 28rpx;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(255, 126, 179, 0.25);
}

.btn-ghost {
  display: inline-flex;
  align-items: center;
  padding: var(--space-sm) var(--space-md);
  color: var(--color-primary);
  font-size: var(--font-base);
  background: transparent;
  border: none;
}

/* ========== 输入框 ========== */
.input-field {
  width: 100%;
  height: 96rpx;
  padding: 0 var(--space-lg);
  background: #FFFFFF;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  font-size: 30rpx;
  color: var(--color-text-primary);
  box-sizing: border-box;
  transition: border-color 0.3s;
}

.input-field:focus {
  border-color: var(--color-primary);
  box-shadow: 0 0 0 4rpx rgba(255, 126, 179, 0.1);
}

/* ========== 标签 ========== */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-pill);
  font-size: var(--font-xs);
  font-weight: var(--weight-medium);
}

.tag-pink { background: #FFF2F7; color: #FF7EB3; }
.tag-purple { background: #F3EAFF; color: #B388FF; }
.tag-green { background: #EEFBF5; color: #5BC9A0; }
.tag-orange { background: #FFF8EE; color: #FFB74D; }
.tag-red { background: #FFF2F2; color: #FF7979; }
.tag-blue { background: #EEF4FF; color: #82B1FF; }
.tag-violet { background: #F3EAFF; color: #B388FF; }

/* ========== 徽标 ========== */
.badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-pill);
  font-size: var(--font-xs);
}

.badge-success { background: #EEFBF5; color: #5BC9A0; }
.badge-warning { background: #FFFCE8; color: #E6B800; }
.badge-error { background: #FFF2F2; color: #FF7979; }

/* ========== 进度条 ========== */
.progress-bar {
  width: 100%;
  height: 12rpx;
  background: var(--color-border-light);
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-bar .fill {
  height: 100%;
  background: var(--gradient-dreamy);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 64rpx;
}

.empty-state .emoji {
  font-size: 96rpx;
  margin-bottom: var(--space-lg);
  opacity: 0.5;
}

.empty-state .text {
  font-size: var(--font-base);
  color: var(--color-text-tertiary);
}

/* ========== 模块标题 ========== */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: var(--space-md);
}

.section-header .title {
  font-size: var(--font-md);
  font-weight: var(--weight-bold);
  color: var(--color-text-primary);
}

.section-header .action {
  font-size: var(--font-sm);
  color: var(--color-primary);
}

/* ========== 安全区 ========== */
.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* ========== 核销码等宽 ========== */
.mono {
  font-family: 'Courier New', 'SFMono-Regular', Consolas, monospace;
  letter-spacing: 12rpx;
}
